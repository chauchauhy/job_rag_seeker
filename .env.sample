# OpenCode LLM used for structured extraction
OPENCODE_MODEL=opencode-go/deepseek-v4-flash

# JobsDB crawler
JOBSDB_BASE_URL=https://hk.jobsdb.com/analyst-programmer-jobs/in-Hong-Kong-SAR
JOBSDB_TARGET_COUNT=90
JOBSDB_OUTPUT_FILE=data/raw/jobsdb_analyst_programmer_jobs.json

# Resume processing
RESUME_PDF_PATH=<path_to_resume_pdf>
RESUME_MARKDOWN_OUTPUT=results/resume.md
RESUME_JSON_OUTPUT=results/resume.json

# Qdrant vector database
# Cloud mode (default): ONLINE_QDRANT_ENDPOINT + ONLINE_QDRANT_KEY point at
# Qdrant Cloud. For embedded/local mode instead, set QDRANT_PATH (files on
# disk) and comment out ONLINE_QDRANT_ENDPOINT/ONLINE_QDRANT_KEY below.
QDRANT_COLLECTION=jobs_collection
ONLINE_QDRANT_ENDPOINT="XXX"
ONLINE_QDRANT_KEY="XXX"
# QDRANT_PATH=qdrant_storage
# QDRANT_URL=http://localhost:6333

# Embedding models (FastEmbed, downloaded on first use)
EMBEDDING_MODEL=colbert-ir/colbertv2.0
SPARSE_EMBEDDING_MODEL=Qdrant/bm25

# HNSW index tuning (dense vectors)
QDRANT_HNSW_M=32
QDRANT_HNSW_EF_CONSTRUCT=512
QDRANT_HNSW_FULL_SCAN_THRESHOLD=10000

# RAG chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Hybrid search (dense + BM25 fused with RRF)
PREFETCH_LIMIT=50
SEARCH_LIMIT=10
